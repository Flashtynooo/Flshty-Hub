local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Library = {}

function Library:CreateWindow(titleText)
	-- ScreenGui Principale
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "FlshtyHubUI"
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.ResetOnSpawn = false
	screenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	-- Fenêtre Principale (HOME)
	local home = Instance.new("Frame")
	home.Name = "HOME"
	home.Size = UDim2.new(0, 380, 0, 260)
	home.Position = UDim2.new(0.5, -190, 0.5, -130)
	home.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	home.BorderSizePixel = 0
	home.Parent = screenGui

	local homeCorner = Instance.new("UICorner")
	homeCorner.CornerRadius = UDim.new(0, 8)
	homeCorner.Parent = home

	local uiStroke = Instance.new("UIStroke")
	uiStroke.Thickness = 2
	uiStroke.Color = Color3.fromRGB(0, 255, 22)
	uiStroke.Parent = home

	-- Barre supérieure (Dragger)
	local dragger = Instance.new("Frame")
	dragger.Name = "Dragger"
	dragger.Size = UDim2.new(1, 0, 0, 35)
	dragger.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
	dragger.BorderSizePixel = 0
	dragger.ZIndex = 3
	dragger.Parent = home

	local draggerCorner = Instance.new("UICorner")
	draggerCorner.CornerRadius = UDim.new(0, 8)
	draggerCorner.Parent = dragger

	-- Titre
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.new(1, -70, 1, 0)
	titleLabel.Position = UDim2.new(0, 10, 0, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.TextSize = 14
	titleLabel.Font = Enum.Font.SourceSansBold
	titleLabel.Text = titleText or "Flshty Hub"
	titleLabel.ZIndex = 4
	titleLabel.Parent = dragger

	-- Bouton Flottant (Image Button avec Decal ID)
	local toggleOpenBtn = Instance.new("ImageButton")
	toggleOpenBtn.Name = "ToggleOpenBtn"
	toggleOpenBtn.Size = UDim2.new(0, 45, 0, 45)
	toggleOpenBtn.Position = UDim2.new(0, 15, 0.5, -22)
	toggleOpenBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	toggleOpenBtn.Image = "rbxassetid://76126150119912"
	toggleOpenBtn.Visible = false -- Masqué au départ car le Hub est ouvert
	toggleOpenBtn.ZIndex = 10
	toggleOpenBtn.Parent = screenGui

	local openCorner = Instance.new("UICorner")
	openCorner.CornerRadius = UDim.new(1, 0)
	openCorner.Parent = toggleOpenBtn

	local openStroke = Instance.new("UIStroke")
	openStroke.Thickness = 2
	openStroke.Color = Color3.fromRGB(0, 255, 22)
	openStroke.Parent = toggleOpenBtn

	-- Fonction de gestion de visibilité synchronisée
	local function setHubVisible(state)
		home.Visible = state
		toggleOpenBtn.Visible = not state
	end

	-- Bouton Fermer (X) -> Rend uniquement invisible
	local closeBtn = Instance.new("TextButton")
	closeBtn.Name = "CloseBtn"
	closeBtn.Size = UDim2.new(0, 25, 0, 25)
	closeBtn.Position = UDim2.new(1, -30, 0.5, -12)
	closeBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
	closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeBtn.Text = "X"
	closeBtn.Font = Enum.Font.SourceSansBold
	closeBtn.TextSize = 14
	closeBtn.ZIndex = 4
	closeBtn.Parent = dragger

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 4)
	closeCorner.Parent = closeBtn

	closeBtn.MouseButton1Click:Connect(function()
		setHubVisible(false)
	end)

	toggleOpenBtn.MouseButton1Click:Connect(function()
		setHubVisible(true)
	end)

	-- Touche Clavier (PC: Touche "-")
	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == Enum.KeyCode.Minus or input.KeyCode == Enum.KeyCode.KeypadMinus then
			setHubVisible(not home.Visible)
		end
	end)

	-- Zone des Onglets (Catégories)
	local categoryBar = Instance.new("ScrollingFrame")
	categoryBar.Name = "CategoryBar"
	categoryBar.Size = UDim2.new(1, -20, 0, 30)
	categoryBar.Position = UDim2.new(0, 10, 0, 40)
	categoryBar.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	categoryBar.BorderSizePixel = 0
	categoryBar.ScrollBarThickness = 2
	categoryBar.ScrollingDirection = Enum.ScrollingDirection.X
	categoryBar.AutomaticCanvasSize = Enum.AutomaticSize.X
	categoryBar.CanvasSize = UDim2.new(0, 0, 0, 0)
	categoryBar.Parent = home

	local catLayout = Instance.new("UIListLayout")
	catLayout.FillDirection = Enum.FillDirection.Horizontal
	catLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	catLayout.SortOrder = Enum.SortOrder.LayoutOrder
	catLayout.Padding = UDim.new(0, 5)
	catLayout.Parent = categoryBar

	local catPadding = Instance.new("UIPadding")
	catPadding.PaddingLeft = UDim.new(0, 5)
	catPadding.PaddingRight = UDim.new(0, 5)
	catPadding.Parent = categoryBar

	-- Conteneur des Pages
	local pagesContainer = Instance.new("Frame")
	pagesContainer.Name = "PagesContainer"
	pagesContainer.Size = UDim2.new(1, -20, 1, -80)
	pagesContainer.Position = UDim2.new(0, 10, 0, 75)
	pagesContainer.BackgroundTransparency = 1
	pagesContainer.Parent = home

	-- Déplacement de la fenêtre
	task.spawn(function()
		local dragging = false
		local dragStart, startPos

		dragger.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = home.Position
			end
		end)

		dragger.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				home.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end)
	end)

	-- Gestionnaire de fenêtres et catégories
	local WindowHandler = {
		Pages = {},
		ActivePage = nil
	}

	function WindowHandler:AddCategory(categoryName)
		local catBtn = Instance.new("TextButton")
		catBtn.Name = categoryName
		catBtn.Size = UDim2.new(0, 90, 0, 24)
		catBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		catBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
		catBtn.Text = categoryName
		catBtn.Font = Enum.Font.SourceSansBold
		catBtn.TextSize = 13
		catBtn.Parent = categoryBar

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 4)
		btnCorner.Parent = catBtn

		local pageScroll = Instance.new("ScrollingFrame")
		pageScroll.Name = categoryName .. "_Page"
		pageScroll.Size = UDim2.new(1, 0, 1, 0)
		pageScroll.BackgroundTransparency = 1
		pageScroll.BorderSizePixel = 0
		pageScroll.ScrollBarThickness = 4
		pageScroll.ScrollBarImageColor3 = Color3.fromRGB(0, 255, 22)
		pageScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		pageScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
		pageScroll.Visible = false
		pageScroll.Parent = pagesContainer

		local pageLayout = Instance.new("UIListLayout")
		pageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
		pageLayout.Padding = UDim.new(0, 6)
		pageLayout.Parent = pageScroll

		local pagePadding = Instance.new("UIPadding")
		pagePadding.PaddingTop = UDim.new(0, 5)
		pagePadding.PaddingBottom = UDim.new(0, 5)
		pagePadding.Parent = pageScroll

		if not WindowHandler.ActivePage then
			WindowHandler.ActivePage = pageScroll
			pageScroll.Visible = true
			catBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 22)
			catBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
		end

		catBtn.MouseButton1Click:Connect(function()
			for _, p in pairs(WindowHandler.Pages) do
				p.Page.Visible = false
				p.Button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
				p.Button.TextColor3 = Color3.fromRGB(200, 200, 200)
			end
			pageScroll.Visible = true
			catBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 22)
			catBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
			WindowHandler.ActivePage = pageScroll
		end)

		table.insert(WindowHandler.Pages, {
			Page = pageScroll,
			Button = catBtn
		})

		local PageElements = {}

		function PageElements:AddButton(text, callback)
			local btn = Instance.new("TextButton")
			btn.Name = text
			btn.Size = UDim2.new(0.95, 0, 0, 32)
			btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.Text = text
			btn.Font = Enum.Font.SourceSansBold
			btn.TextSize = 14
			btn.Parent = pageScroll

			local bCorner = Instance.new("UICorner")
			bCorner.CornerRadius = UDim.new(0, 4)
			bCorner.Parent = btn

			btn.MouseButton1Click:Connect(function()
				pcall(callback)
			end)

			return btn
		end

		function PageElements:AddToggle(text, defaultState, callback)
			local state = defaultState or false

			local toggleFrame = Instance.new("Frame")
			toggleFrame.Name = text
			toggleFrame.Size = UDim2.new(0.95, 0, 0, 32)
			toggleFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
			toggleFrame.Parent = pageScroll

			local tCorner = Instance.new("UICorner")
			tCorner.CornerRadius = UDim.new(0, 4)
			tCorner.Parent = toggleFrame

			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(0.7, 0, 1, 0)
			label.Position = UDim2.new(0, 10, 0, 0)
			label.BackgroundTransparency = 1
			label.Text = text
			label.TextColor3 = Color3.fromRGB(255, 255, 255)
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Font = Enum.Font.SourceSansBold
			label.TextSize = 14
			label.Parent = toggleFrame

			local indicator = Instance.new("TextButton")
			indicator.Size = UDim2.new(0, 45, 0, 22)
			indicator.Position = UDim2.new(1, -50, 0.5, -11)
			indicator.BackgroundColor3 = state and Color3.fromRGB(0, 255, 22) or Color3.fromRGB(60, 60, 60)
			indicator.Text = state and "ON" or "OFF"
			indicator.TextColor3 = state and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
			indicator.Font = Enum.Font.SourceSansBold
			indicator.TextSize = 12
			indicator.Parent = toggleFrame

			local indCorner = Instance.new("UICorner")
			indCorner.CornerRadius = UDim.new(0, 4)
			indCorner.Parent = indicator

			local function toggle()
				state = not state
				indicator.BackgroundColor3 = state and Color3.fromRGB(0, 255, 22) or Color3.fromRGB(60, 60, 60)
				indicator.Text = state and "ON" or "OFF"
				indicator.TextColor3 = state and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
				pcall(callback, state)
			end

			indicator.MouseButton1Click:Connect(toggle)
			return toggleFrame
		end

		return PageElements
	end

	return WindowHandler
end

return Library
