-- Script de rotation pour la première Frame (G2L["3"])
local function C_4()
	local script = G2L["4"]
	local TweenService = game:GetService("TweenService")
	local frame = script.Parent

	local DUREE = 1.5
	local tweenInfo = TweenInfo.new(DUREE, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	local tween = TweenService:Create(frame, tweenInfo, {
		Rotation = frame.Rotation + 360,
		BackgroundTransparency = 1
	})

	tween:Play()
	tween.Completed:Connect(function()
		frame.Visible = false
	end)
end
task.spawn(C_4)

